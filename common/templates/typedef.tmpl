{{range .Types}}
{{ .DocComment }}
type {{.TypeName}} {{if .IsAlias }}={{end}} {{.Schema.TypeDecl}}
{{- if and (not .IsAlias) .Schema.Properties}}

// WithDefaults returns a copy of {{.TypeName}} with unset fields set to their OpenAPI defaults.
func (v {{.TypeName}}) WithDefaults() {{.TypeName}} {
{{- range .Schema.Properties}}
{{- $d := .Schema.OAPISchema.Default}}
{{- if ne $d nil}}
{{- if or .Schema.ArrayType .Schema.OAPISchema.AdditionalProperties.Schema}}
{{- $type := .GoTypeDef}}{{if .HasOptionalPointer}}{{$type = slice .GoTypeDef 1}}{{end}}
	if v.{{.GoFieldName}} == nil {
		value := {{$type}}{ {{- if .Schema.ArrayType}}{{range $i, $e := $d}}{{if $i}}, {{end}}{{printf "%#v" $e}}{{end}}{{else}}{{range $k, $e := $d}}{{printf "%q" $k}}: {{printf "%#v" $e}}, {{end}}{{end -}} }
		v.{{.GoFieldName}} = {{if .HasOptionalPointer}}&{{end}}value
	}
{{- else if .HasOptionalPointer}}
	if v.{{.GoFieldName}} == nil {
		v.{{.GoFieldName}} = new({{slice .GoTypeDef 1}}({{printf "%#v" $d}}))
	}
{{- end}}
{{- else if and .Schema.ArrayType (or .Schema.ArrayType.RefType .Schema.ArrayType.DefineViaAlias) .Schema.ArrayType.OAPISchema.Properties}}
{{- $type := .GoTypeDef}}{{if .HasOptionalPointer}}{{$type = slice .GoTypeDef 1}}{{end}}
	if v.{{.GoFieldName}} != nil {
		items := make({{$type}}, len({{if .HasOptionalPointer}}*{{end}}v.{{.GoFieldName}}))
		for i, item := range {{if .HasOptionalPointer}}*{{end}}v.{{.GoFieldName}} {
			items[i] = item.WithDefaults()
		}
		v.{{.GoFieldName}} = {{if .HasOptionalPointer}}&{{end}}items
	}
{{- else if and .Schema.OAPISchema.Properties (ne (slice (printf "%-6s" .Schema.GoType) 0 6) "struct")}}
{{- if .HasOptionalPointer}}
	if v.{{.GoFieldName}} != nil {
		withDefaults := v.{{.GoFieldName}}.WithDefaults()
		v.{{.GoFieldName}} = &withDefaults
	}
{{- else}}
	v.{{.GoFieldName}} = v.{{.GoFieldName}}.WithDefaults()
{{- end}}
{{- end}}
{{- end}}
	return v
}
{{- end}}
{{- if and (not .IsAlias) .Schema.Properties}}
{{- $state := .}}
{{- range $.Types}}
{{- if and (not .IsAlias) (eq (printf "%sState" .TypeName) $state.TypeName)}}
{{- $spec := .}}

// Spec returns the desired state held in s: the fields a PUT of {{$spec.TypeName}} sends. Shallow copy.
func (s {{$state.TypeName}}) Spec() {{$spec.TypeName}} {
	return {{$spec.TypeName}}{
{{- range $spec.Schema.Properties}}
{{- $field := .}}{{$value := printf "s.%s" .GoFieldName}}
{{- range $state.Schema.Properties}}
{{- if and (eq .GoFieldName $field.GoFieldName) (ne .GoTypeDef $field.GoTypeDef)}}{{$value = printf "(%s)(s.%s)" $field.GoTypeDef .GoFieldName}}{{end}}
{{- end}}
		{{.GoFieldName}}: {{$value}},
{{- end}}
	}
}
{{- end}}
{{- end}}
{{- end}}
{{end}}
